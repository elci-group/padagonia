# Documentation website assets (not needed for the build)
# Keep docs/openapi.json in the build context: the HTTP server embeds it at
# compile time. Other documentation is not needed for the image.
/docs/*
!/docs/openapi.json

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Local runtime data / config overrides
/data
*.pad
padagonia.toml
